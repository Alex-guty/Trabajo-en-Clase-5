
{
  "ConnectionStrings": {
    "MyDb": "Server=(localdb)\\mssqllocaldb;Database=MyLibraryDb;Trusted_Connection=true;MultipleActiveResultSets=true"
  },
  "UseDatabase": true,
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5182"
      },
      "Https": {
        "Url": "https://localhost:5183",
        "Certificate": {
          "Store": "My",
          "StoreLocation": "CurrentUser",
          "SubjectName": "CN=localhost"
        }
      }
    }
  },
  "UseJson": true
}
