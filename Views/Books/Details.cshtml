@model MyLibrary.Models.LibroDto

@{
    ViewData["Title"] = "Book Details";
}

<h1>@Model.OriginalName</h1>

<div>
    <h4>Book Details</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            Original Name
        </dt>
        <dd class = "col-sm-10">
            @Model.OriginalName
        </dd>
        <dt class = "col-sm-2">
            Spanish Name
        </dt>
        <dd class = "col-sm-10">
            @Model.SpanishName
        </dd>
        <dt class = "col-sm-2">
            Edition
        </dt>
        <dd class = "col-sm-10">
            @Model.Edition
        </dd>
        <dt class = "col-sm-2">
            Year
        </dt>
        <dd class = "col-sm-10">
            @Model.Year
        </dd>
        <dt class = "col-sm-2">
            Editor
        </dt>
        <dd class = "col-sm-10">
            @Model.Editor
        </dd>
        <dt class = "col-sm-2">
            Antiquity
        </dt>
        <dd class = "col-sm-10">
            @Model.Antiquity years
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Index" class="btn btn-primary">Back to List</a>
</div>
